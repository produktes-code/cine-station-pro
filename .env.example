# =========================================================================
# CineStation Pro - Environment Variables Template
# Copy this file to '.env' and fill in your credentials.
# =========================================================================

# Backend Server Configuration
PORT=8000
HOST=127.0.0.1
ENV=development
LOG_LEVEL=INFO

# Security & CORS Settings
# Secret key for sessions/tokens (generate a secure random value in production)
SECRET_KEY=generate_a_random_secure_key_here
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,app://.
RATE_LIMIT_PER_MINUTE=60

# AI Provider API Keys
GEMINI_API_KEY=your_gemini_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Replicate Token for Cloud Video Models (Wan 2.2 / Hunyuan Video)
REPLICATE_API_TOKEN=your_replicate_api_token_here
